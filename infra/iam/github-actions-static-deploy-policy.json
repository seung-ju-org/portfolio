{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStaticPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::portfolio-2020.seung-ju.com",
      "Condition": { "StringLike": { "s3:prefix": ["ssg/*", "releases/*"] } }
    },
    {
      "Sid": "WriteStaticAndReleaseObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::portfolio-2020.seung-ju.com/ssg/*",
        "arn:aws:s3:::portfolio-2020.seung-ju.com/releases/*"
      ]
    },
    {
      "Sid": "ReadBucketPolicyForBackup",
      "Effect": "Allow",
      "Action": "s3:GetBucketPolicy",
      "Resource": "arn:aws:s3:::portfolio-2020.seung-ju.com"
    },
    {
      "Sid": "InvalidateKnownDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistributionConfig", "cloudfront:CreateInvalidation"],
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/EL15WJYWXRAIG"
    }
  ]
}
